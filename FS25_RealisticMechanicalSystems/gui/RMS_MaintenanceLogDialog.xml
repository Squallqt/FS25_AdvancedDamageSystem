<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer"/>
    <RoundCorner profile="rms_dialogScreenBlocker" id="dialogScreenBlocker"/>
    <Bitmap profile="dialogFullscreenBg" id="dialogBg"/>

    <GuiElement profile="rms_dialogBg" id="dialogElement" with="anchorMiddleCenter"  position="0px -50px">
        <ThreePartBitmap profile="fs25_dialogBgMiddle"/>
        <ThreePartBitmap profile="fs25_dialogBgTop"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>
        
        <GuiElement profile="fs25_dialogContentContainer">
            <!-- HEADER -->
            <GuiElement profile="fs25_menuHeaderPanel" absoluteSizeOffset="0px 0px">
                <Bitmap profile="fs25_menuHeaderIconBg">
                    <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_vehicleDealer_machines" />
                </Bitmap>
                <Text profile="fs25_menuHeaderTitle" id="headerText" text="$l10n_rms_log_header_title"/>
                <RoundCorner profile="fs25_shopMoneyBoxBg" id="moneyBoxBg"/>
                <BoxLayout profile="fs25_shopMoneyBox" id="moneyBox">
                    <Text profile="fs25_shopBalance" id="balanceTitleElement" text="$l10n_ui_balance" />
                    <Text profile="fs25_shopMoney" id="balanceElement"/>
                </BoxLayout>
            </GuiElement>
            
            <!-- =============================================================== -->
            <!-- VEHICLE INFO                                                    -->
            <!-- =============================================================== -->
            <GuiElement profile="rms_logInfoContainer">
               <ThreePartBitmap profile="rms_containerFrame"/>
                    <Text profile="rms_headerBoldText" id="vehicleNameValue" text="John Deere 1900" position="30px 60px" size="100% 40px"/>

                    <Text profile="rms_textBold" id="totalCostTitle" text="$l10n_rms_log_total_cost_title" position="30px 100px"/>
                    <Text profile="fs25_textDefault" id="totalCostValue" text="-" position="250px 100px" textBold="false"/>

                    <Text profile="rms_textBold" id="costPerMonthTitle" text="$l10n_rms_log_cost_per_month_title" position="500px 100px"/>
                    <Text profile="fs25_textDefault" id="costPerMonthValue" text="-" position="750px 100px"/>

                    <Text profile="rms_textBold" id="ownershipMonthsTitle" text="$l10n_rms_log_ownership_months_title" position="970px 100px"/>
                    <Text profile="fs25_textDefault" id="ownershipMonthsValue" text="-" position="1220px 100px"/>

                    <Text profile="rms_textBold" id="totalBreakdownsCountTitle" text="$l10n_rms_log_total_breakdowns_count_title" position="30px 60px"/>
                    <Text profile="fs25_textDefault" id="totalBreakdownsCountValue" text="-" position="250px 60px"/>

                    <Text profile="rms_textBold" id="averageBreakdownsIntervalTitle" text="$l10n_rms_log_average_breakdowns_interval_title" position="500px 60px"/>
                    <Text profile="fs25_textDefault" id="averageBreakdownsIntervalValue" text="-" position="750px 60px"/>

                    <Text profile="rms_textBold" id="averageMaintenanceIntervalTitle" text="$l10n_rms_log_average_maintenance_interval_title" position="970px 60px"/>
                    <Text profile="fs25_textDefault" id="averageMaintenanceIntervalValue" text="-" position="1220px 60px"/>

                    <ThreePartBitmap profile="rms_textSeporator" position="-5px 85px" size="1350px 1dp" />

            </GuiElement>

            <!-- =============================================================== -->
            <!-- log TABLE (EXPANDED)                                        -->
            <!-- =============================================================== -->
            <GuiElement profile="rms_logTableContainer">
               <ThreePartBitmap profile="rms_containerFrame"/>
                
                <!-- HEADER -->
                <Bitmap profile="rms_tableList" id="tableHeaderBox" position="50px -30px" size="1290px 50px">
                    <Text profile="rms_tableHeaderLeft" position="20px 0px" size="100px 40.77px" text="$l10n_rms_log_date"/>
                    <Text profile="rms_tableHeaderLeft" position="120px 0px" size="160px 40.77px" text="$l10n_rms_log_hours"/>
                    <Text profile="rms_tableHeaderLeft" position="280px 0px" size="180px 40.77px" text="$l10n_rms_log_type"/>
                    <Text profile="rms_tableHeaderLeft" position="460px 0px" size="700px 40.77px" text="$l10n_rms_log_description"/>
                    <Text profile="rms_tableHeaderLeft" position="1160px 0px" size="120px 40.77px" text="$l10n_rms_log_price" textAlignment="right"/>
                    <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px" />
                </Bitmap>
                
                <SmoothList profile="rms_tableList" id="logTable" position="50px -85px" size="1290px 510px">
                    <ListItem profile="rms_tableListItemSelected" name="logRowTemplate" size="1290px 40.77px" onClick="onRowClick">
                        <Text profile="rms_tableRowCellLeft" position="20px 0px" size="100px 40.77px" name="logDate" />
                        <Text profile="rms_tableRowCellLeft" position="120px 0px" size="160px 40.77px" name="logHours" />
                        <Text profile="rms_tableRowCellLeftUpper" position="280px 0px" size="180px 40.77px" name="logType" />
                        <Text profile="rms_tableRowCellLeft" position="460px 0px" size="700px 40.77px" name="logDescription" textLayoutMode="scrolling"/>
                        <Text profile="rms_tableRowCellLeft" position="1160px 0px" size="120px 40.77px" name="logPrice" textAlignment="right"/>
                    </ListItem>
                </SmoothList>

                <ThreePartBitmap profile="fs25_listSliderBox" position="-50px 0px" size="6px 500px" with="anchorTopRight">
                    <Slider profile="fs25_listSlider" dataElementId="logTable" id="tableSlider" />
                </ThreePartBitmap>
                
                <Text profile="rms_textHeaderGrey" id="emptylogText" text="$l10n_rms_log_empty" position="0px 300px" size="100% 50px"/>
            </GuiElement>
        </GuiElement> 

        <!-- Buttons -->
        <BoxLayout profile="fs25_dialogButtonBox">
            <Button profile="buttonActivate" text="$l10n_rms_log_button_show_report" onClick="onClickShowReport" id="showReportButton"/>
            <Button profile="buttonBack" text="$l10n_button_back" onClick="onClickBack" id="backButton"/>
        </BoxLayout>
        
    </GuiElement>
</GUI>
